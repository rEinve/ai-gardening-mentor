rules_version = '2';

// Normative Firestore Security Rules enforcing docs/schema.md permission matrix.
// Default posture: DENY ALL unless explicitly allowed below.
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isNullableString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isValidPlotType(val) {
      return val in ['in_ground', 'raised_bed', 'container', 'indoor_window'];
    }

    function isValidRainExposure(val) {
      return val in ['exposed', 'sheltered', 'indoor'];
    }

    function isValidSunlight(val) {
      return val in ['full_sun', 'partial_shade', 'deep_shade'];
    }

    function isValidPlantingMethod(val) {
      return val in ['direct_seed', 'transplant'];
    }

    function isValidUnitPreference(val) {
      return val in ['metric', 'imperial'];
    }

    function isValidLocalDate(val) {
      return val is string && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidDimensions(val) {
      return val == null || (
        val is map &&
        val.keys().hasOnly(['lengthMetres', 'widthMetres']) &&
        val.lengthMetres is number && val.lengthMetres > 0 &&
        val.widthMetres is number && val.widthMetres > 0
      );
    }

    // -------------------------------------------------------------------------
    // Reviewed Reference Content (Public read of approved records only)
    // -------------------------------------------------------------------------
    match /cropProfiles/{profileId} {
      allow read: if isSignedIn() && resource.data.reviewStatus in ['approved', 'prototype_fixture'];
      allow write: if false;
    }

    match /careRules/{ruleId} {
      allow read: if isSignedIn() && resource.data.reviewStatus in ['approved', 'prototype_fixture'];
      allow write: if false;
    }

    match /taskTemplates/{templateId} {
      allow read: if isSignedIn() && resource.data.reviewStatus in ['approved', 'prototype_fixture'];
      allow write: if false;
    }

    match /knowledgeSources/{sourceId}/revisions/{revision} {
      allow read: if isSignedIn() && resource.data.reviewStatus in ['approved', 'prototype_fixture'];
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Private User Tree: /users/{uid}
    // -------------------------------------------------------------------------
    match /users/{uid} {
      // Profile: Owner read; update ONLY allowlisted fields (never identity/server metadata)
      allow read: if isOwner(uid);
      allow create, delete: if false;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'geographicLocation',
          'timeZone',
          'unitPreference',
          'gardenExperienceLevel',
          'fcmDeviceTokens',
          'updatedAt'
        ]) &&
        isNullableString(request.resource.data.displayName, 50) &&
        isNonEmptyString(request.resource.data.timeZone, 64) &&
        isValidUnitPreference(request.resource.data.unitPreference);

      // Plots: Owner read; create/update validated garden fields only; delete is server-managed cascade
      match /plots/{plotId} {
        allow read: if isOwner(uid);
        allow delete: if false;
        allow create: if isOwner(uid) &&
          request.resource.data.keys().hasOnly([
            'plotId', 'name', 'plotType', 'rainExposure', 'dimensions', 'sunlightExposure', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.plotId == plotId &&
          isNonEmptyString(request.resource.data.name, 50) &&
          isValidPlotType(request.resource.data.plotType) &&
          isValidRainExposure(request.resource.data.rainExposure) &&
          isValidSunlight(request.resource.data.sunlightExposure) &&
          isValidDimensions(request.resource.data.dimensions);

        allow update: if isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'plotType', 'rainExposure', 'dimensions', 'sunlightExposure', 'updatedAt'
          ]) &&
          isNonEmptyString(request.resource.data.name, 50) &&
          isValidPlotType(request.resource.data.plotType) &&
          isValidRainExposure(request.resource.data.rainExposure) &&
          isValidSunlight(request.resource.data.sunlightExposure) &&
          isValidDimensions(request.resource.data.dimensions);

        // Crops: Owner read; create/edit allowlisted fields only (no forging stage/health/retirement)
        match /crops/{cropId} {
          allow read: if isOwner(uid);
          allow delete: if false;
          allow create: if isOwner(uid) &&
            request.resource.data.keys().hasOnly([
              'cropId', 'cropProfileId', 'variety', 'plantingDate', 'plantingMethod', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.cropId == cropId &&
            isNonEmptyString(request.resource.data.cropProfileId, 64) &&
            isNullableString(request.resource.data.variety, 50) &&
            isValidLocalDate(request.resource.data.plantingDate) &&
            isValidPlantingMethod(request.resource.data.plantingMethod);

          allow update: if isOwner(uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'cropProfileId', 'variety', 'plantingDate', 'plantingMethod', 'updatedAt'
            ]) &&
            isNonEmptyString(request.resource.data.cropProfileId, 64) &&
            isNullableString(request.resource.data.variety, 50) &&
            isValidLocalDate(request.resource.data.plantingDate) &&
            isValidPlantingMethod(request.resource.data.plantingMethod);
        }
      }

      // Task plans: Server-owned (owner read-only)
      match /tasks/{taskId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Completion events: Append-only physical action records (no update/delete/undo in MVP)
      match /taskCompletions/{eventId} {
        allow read: if isOwner(uid);
        allow update, delete: if false;
        allow create: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['eventId', 'taskId', 'completedAt', 'receivedAt']) &&
          request.resource.data.eventId == eventId &&
          isNonEmptyString(request.resource.data.taskId, 128) &&
          request.resource.data.completedAt is timestamp &&
          request.resource.data.receivedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(uid)/tasks/$(request.resource.data.taskId));
      }

      // Requests, triageLogs, chatSessions, messages: Owner read-only; all mutations via authorized endpoints
      match /requests/{requestId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /triageLogs/{diagnosisId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /chatSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // Crop planner batches & farm contact book: Owner read/write
      match /cropBatches/{batchId} {
        allow read, write: if isOwner(uid);
      }

      match /farmContacts/{contactId} {
        allow read, write: if isOwner(uid);
      }

      // Job runs: Internal server scheduling/idempotency only (no direct client access)
      match /jobRuns/{jobKey} {
        allow read, write: if false;
      }
    }

    // Explicit catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
