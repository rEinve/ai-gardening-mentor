{
  "name": "ai-gardening-mentor-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase Cloud Functions backend for AI Gardening Mentor (Tanzania MVP)",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node --test test/phase1.test.ts test/phase2.test.ts test/phase3.test.ts test/phase4.test.ts",
    "test:jest": "jest --coverage",
    "test:rules": "jest test/firestore.rules.test.ts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "seed:emulators": "node src/seeds/seedEmulators.ts"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "firebase": "^10.14.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
