---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const fieldGuideCount = posts.filter((p) => p.data.category === "Field Guide").length;
const appGuideCount = posts.filter((p) => p.data.category === "App Guide").length;
const updatesCount = posts.filter((p) => p.data.category === "Product Updates").length;
---

<section class="section resources" id="resources" aria-labelledby="resources-title">
    <div class="container stack stack--xl">
        <header class="stack stack--sm items-middle text-center">
            <h2 id="resources-title">Field Guides, App Guide &amp; Updates</h2>
            <p class="lead">Offline-ready Tanzania crop manuals, step-by-step app guides, and product updates from our Astro blog.</p>
        </header>

        <div class="grid resources__grid">
            <a class="resources__card resources__card--feature md-col-4 exp-col-4 lg-col-4" href="/blog/#blog-panel-field-guide">
                <span class="resources__visual resources__visual--feature" aria-hidden="true">
                    <img src="/deplying.webp" alt="" loading="lazy" width="295" height="22">
                </span>
                <span class="resources__content">
                    <span class="resources__title">&#123;Field Guide&#125; Tanzania Crop Manuals ({fieldGuideCount})</span>
                    <span class="resources__description">Practical offline &amp; online crop manuals for every starter crop we introduce—Tomato, Cucumber, Bell Pepper, Okra, Ngogwe, Sukuma Wiki, Amaranth, Nightshade &amp; Squash.</span>
                </span>
            </a>

            <div class="resources__list md-col-8 exp-col-8 lg-col-8 stack">
                <a class="resources__card resources__card--compact" href="/blog/#blog-panel-app-guide">
                    <span class="resources__content">
                        <span class="resources__title">&#123;App Guide&#125; ({appGuideCount})</span>
                        <span class="resources__description">How to set up your Waterfall Planner, WhatsApp Photo Upload &amp; Farm Contact Book</span>
                    </span>
                    <span class="resources__visual resources__visual--blog" aria-hidden="true">
                        <img src="/whats-new.webp" alt="" loading="lazy" width="148" height="149">
                    </span>
                </a>

                <a class="resources__card resources__card--compact" href="/blog/#blog-panel-product-updates">
                    <span class="resources__content">
                        <span class="resources__title">&#123;Product Updates&#125; ({updatesCount})</span>
                        <span class="resources__description">What is new in the AI Gardening Mentor Tanzania Pilot</span>
                    </span>
                    <span class="resources__visual resources__visual--guide" aria-hidden="true">
                        <img src="/guites.webp" alt="" loading="lazy" width="156" height="78">
                    </span>
                </a>
            </div>
        </div>
    </div>
</section>
