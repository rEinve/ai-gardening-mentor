---
import DemoVideoEmbed from "./DemoVideoEmbed.astro";

interface Props {
  demoVideoUrl?: string;
  demoVideoPoster?: string;
}

const { demoVideoUrl = "", demoVideoPoster = "/media/diagnosis-workshop.jpg" } = Astro.props;
---

<section id="top" aria-labelledby="hero-title">
  <div class="container">
    <div class="grid hero inverse-surface">
      <div class="md-col-8-centered exp-col-12-centered lg-col-8-centered items-middle hero__content">
        <p class="eyebrow eyebrow--pill"><span class="eyebrow__label">Built for Real Garden Beds &amp; Dirt • University Extension Science</span><span class="eyebrow__index">Pilot</span></p>
        <h1 class="hero__title" id="hero-title">Stop Guessing. Stop Panicking.<br>Grow Vegetables with Confidence.</h1>
        <p class="hero__lead">The first intelligent gardening mentor built specifically to eliminate novice anxiety—get instant 3-step calm triage from a photo, follow 5-minute weather-adaptive habits, and plan every crop from planting to harvest.</p>
        <ul class="cluster justify-center items-middle hero__proof" aria-label="Core capabilities">
          <li class="hero__proof-item"><span class="material-icons-round" aria-hidden="true">check</span>3-Step Panic Triage</li>
          <li class="hero__proof-item"><span class="material-icons-round" aria-hidden="true">check</span>Waterfall Crop Planner</li>
          <li class="hero__proof-item"><span class="material-icons-round" aria-hidden="true">check</span>5-Min Daily Micro-Habits</li>
        </ul>
        <div class="cluster justify-center hero__actions">
          <a class="button button--primary" href="#pricing">Download the App <span class="button__icon material-icons-round" aria-hidden="true">north_east</span></a>
          <a class="button button--ghost" href="#triage-tabs">Try Live Diagnosis <span class="button__icon material-icons-round" aria-hidden="true">photo_camera</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="demo-video" aria-labelledby="demo-video-title">
  <div class="container">
    <div class="grid">
      <div class="md-col-10-centered exp-col-10-centered lg-col-8-centered">
        <div class="card surface-container-low stack stack--sm text-center">
          <div class="card__body stack stack--sm items-middle">
            <p class="eyebrow eyebrow--pill"><span class="eyebrow__label">3-Minute Animated Demo</span><span class="eyebrow__index">Video</span></p>
            <h2 class="h3" id="demo-video-title">Watch how AI Gardening Mentor replaces panic with a calm plan</h2>
            <DemoVideoEmbed
              videoUrl={demoVideoUrl}
              poster={demoVideoPoster}
              title="3-Minute Animated Demo — AI Gardening Mentor"
              caption="3-minute animated walkthrough demonstrating Setup, Waterfall Crop Planner, 14-Day Prepare Ahead alerts, WhatsApp Photo Triage, and Farm Contacts."
            />
            <a class="button button--secondary" href="/blog/#blog-panel-product-updates">Explore Product Updates &amp; Guides</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
