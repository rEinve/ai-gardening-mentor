---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Join Pilot or Farm Enterprise | AI Gardening Mentor"
  description="Request Tanzania Pilot access or discuss a Farm Enterprise Management deployment with IntelliWebLab."
>
  <section class="section contact-page" id="top" aria-labelledby="contact-page-title">
    <div class="container">
      <div class="grid">
        <div class="contact-page__intro col-full md-col-10-centered exp-col-8-centered stack stack--sm text-center">
          <p class="eyebrow eyebrow--pill margin-inline-auto"><span class="eyebrow__label">AI Gardening Mentor</span><span class="eyebrow__index">Pilot &amp; Enterprise</span></p>
          <h1 id="contact-page-title">Let’s get your garden or farm set up.</h1>
          <p class="lead">Answer a few short questions to join the free Tanzania Pilot or scope a Farm Enterprise Management deployment.</p>
        </div>

        <div class="contact-flow col-full md-col-10-centered exp-col-8-centered" data-contact-flow>
          <div class="contact-flow__header cluster justify-between items-middle">
            <p class="contact-flow__progress" data-progress>Question 1 of 5</p>
            <p class="contact-flow__status" data-status>Tanzania Pilot</p>
          </div>

          <form class="contact-flow__form" id="contact-form" novalidate>
            <div class="contact-flow__step" data-step="1">
              <p class="contact-flow__step-number">01</p>
              <h2>What would you like help with?</h2>
              <p class="contact-flow__hint">Choose the option closest to what you need right now.</p>
              <div class="contact-flow__options stack stack--xs">
                <label class="contact-flow__option"><input type="radio" name="interest" value="Join the free Tanzania Pilot" required><span>Join the free Tanzania Pilot</span></label>
                <label class="contact-flow__option"><input type="radio" name="interest" value="Join the Grower tier waitlist"><span>Join the Grower tier waitlist</span></label>
                <label class="contact-flow__option"><input type="radio" name="interest" value="Discuss Farm Enterprise Management"><span>Discuss Farm Enterprise Management</span></label>
              </div>
            </div>

            <div class="contact-flow__step" data-step="2" hidden>
              <p class="contact-flow__step-number">02</p>
              <h2>Which region and crops are you growing?</h2>
              <p class="contact-flow__hint">For example: Dodoma (Tomato, Sukuma Wiki) or Arusha (Greenhouse Bell Pepper).</p>
              <label class="contact-flow__field"><span class="visually-hidden">Region and crops</span><input class="input" type="text" name="business" placeholder="For example, Dodoma — Tomato &amp; Sukuma Wiki" required></label>
            </div>

            <div class="contact-flow__step" data-step="3" hidden>
              <p class="contact-flow__step-number">03</p>
              <h2>Which device will you use most?</h2>
              <p class="contact-flow__hint">AI Gardening Mentor is built for Android and Chrome Web.</p>
              <div class="contact-flow__options stack stack--xs">
                <label class="contact-flow__option"><input type="radio" name="channel" value="Android phone" required><span>Android phone</span></label>
                <label class="contact-flow__option"><input type="radio" name="channel" value="Chrome Web (laptop or desktop)"><span>Chrome Web (laptop or desktop)</span></label>
                <label class="contact-flow__option"><input type="radio" name="channel" value="Both Android and Chrome Web"><span>Both Android and Chrome Web</span></label>
              </div>
            </div>

            <div class="contact-flow__step" data-step="4" hidden>
              <p class="contact-flow__step-number">04</p>
              <h2>What is your biggest challenge in the garden or farm?</h2>
              <p class="contact-flow__hint">A sentence or two is enough.</p>
              <label class="contact-flow__field"><span class="visually-hidden">Biggest challenge</span><textarea class="input" name="challenge" rows="4" placeholder="For example, tracking fertilizer dates or diagnosing leaf spots sent on WhatsApp" required></textarea></label>
            </div>

            <div class="contact-flow__step" data-step="5" hidden>
              <p class="contact-flow__step-number">05</p>
              <h2>Where should we send your invite?</h2>
              <p class="contact-flow__hint">We’ll only use these details to respond to your request.</p>
              <div class="contact-flow__fields stack stack--sm">
                <label class="contact-flow__field"><span class="visually-hidden">Your name</span><input class="input" type="text" name="name" autocomplete="name" placeholder="Your name" required></label>
                <label class="contact-flow__field"><span class="visually-hidden">Email address</span><input class="input" type="email" name="email" autocomplete="email" placeholder="Email address" required></label>
                <label class="contact-flow__field"><span class="visually-hidden">WhatsApp / Phone number, optional</span><input class="input" type="tel" name="phone" autocomplete="tel" placeholder="WhatsApp / Phone number (optional)"></label>
              </div>
            </div>

            <div class="contact-flow__review" data-review hidden>
              <p class="contact-flow__step-number">Review</p>
              <h2>Check your request before sending.</h2>
              <p class="contact-flow__hint">You can edit any answer before submitting.</p>
              <dl class="contact-flow__summary" data-summary></dl>
            </div>

            <p class="contact-flow__error" data-error role="alert" hidden>Please answer this question before continuing.</p>
            <div class="contact-flow__actions cluster justify-between items-middle">
              <button class="button button--ghost" type="button" data-back hidden>Back</button>
              <span class="contact-flow__action-spacer"></span>
              <button class="button button--primary" type="button" data-next>Continue <span class="button__icon material-icons-round" aria-hidden="true">arrow_forward</span></button>
              <button class="button button--primary" type="submit" data-submit hidden>Send request <span class="button__icon material-icons-round" aria-hidden="true">north_east</span></button>
            </div>
          </form>

          <div class="contact-flow__success stack stack--sm items-middle text-center" data-success hidden>
            <span class="contact-flow__success-icon material-icons-round" aria-hidden="true">check</span>
            <h2>Thanks—we’ve received your request.</h2>
            <p>Our team will follow up with your Tanzania Pilot link or Farm Enterprise walkthrough.</p>
            <a class="button button--ghost" href="/">Return home <span class="button__icon material-icons-round" aria-hidden="true">arrow_back</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
